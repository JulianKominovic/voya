{
  "name": "voya-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i src/styles.css -o dist/styles.css --minify && node build.mjs",
    "watch": "tailwindcss -i src/styles.css -o dist/styles.css --watch & node build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
